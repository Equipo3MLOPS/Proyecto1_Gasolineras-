<mxfile host="app.diagrams.net"><diagram id="arquitectura" name="Arquitectura"><mxGraphModel dx="1700" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="&lt;b&gt;Arquitectura de la plataforma · Equipo 3 · Predicción del precio de la gasolina en Guatemala&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#111111;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="32" as="geometry"/></mxCell><mxCell id="n12" value="Bronce → Plata → Oro en Databricks sobre S3; la API del Droplet solo lee la capa Oro. Flechas negras: datos · azules: red (HTTP y SSH) · grises punteadas: desarrollo y despliegue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1660" height="22" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;equipo-03-gasolina-gt&lt;br&gt;pipelines/ · src/ · api/ · docs/&lt;br&gt;GitHub Actions valida el bundle&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F4F4;strokeColor=#7A7A7A;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=0;fontColor=#1F1F1F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="145" width="230" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Equipo 3&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;desarrolla en notebooks y en local (make), hace push y despliega&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F4F4;strokeColor=#7A7A7A;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=0;fontColor=#1F1F1F;fon