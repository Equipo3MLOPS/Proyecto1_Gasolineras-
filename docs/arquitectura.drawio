modelo · predicciones&lt;br&gt;metricas_modelo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8E7A6;strokeColor=#B08A00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=0;fontColor=#1F1F1F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="645" width="210" height="135" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Integrantes con llave SSH&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;despliegan con git pull + docker compose&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F4F4F4;strokeColor=#7A7A7A;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=0;fontColor=#1F1F1F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="90" width="360" height="60" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Droplet DigitalOcean (compartido)&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;usuario equipo-03 · /home/equipo-03/&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EAF2FF;strokeColor=#0069FF;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;dashed=0;fontColor=#1F1F1F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1280" y="200" width="400" height="360" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;.env&lt;/b&gt; con permisos 600, fuera de Git&lt;br&gt;&lt;span style='font-size:11px'&gt;token de Databricks · GOLD_MODE=databricks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0069FF;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;fontColor=#1F1F1F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="255" width="360" height="55" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Contenedor Docker «api-gasolineras»&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;FastAPI + uvicorn · restart: unless-stopped&lt;