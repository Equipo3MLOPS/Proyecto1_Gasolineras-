# Copiar a `.env` y completar. NUNCA subir el .env real al repo (ver .gitignore).

# Origen de los datos oro:
#   databricks -> lee vía el SQL Warehouse de Databricks (con un token del usuario)
#   s3         -> lee los Delta directamente del bucket oro (requiere acceso S3)
#   local      -> lee parquet de LOCAL_GOLD_DIR (desarrollo)
GOLD_MODE=databricks

# --- Modo databricks (el que usamos en el Droplet) ---------------------------
DATABRICKS_HOST=https://dbc-a56ba7f1-976e.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=aa1fd558f80e0607
UC_CATALOG=workspace
# Token (PAT) del usuario -> Databricks: Settings > Developer > Access tokens.
# Es un SECRETO: va solo acá, nunca en el repo.
DATABRICKS_TOKEN=

# --- Modo s3 (si algún día el bucket oro es accesible desde el server) --------
GOLD_BUCKET=cc3105-au-869227452861-us-east-2-an
TEAM=equipo3
AWS_REGION=us-east-2
# Normalmente en blanco: usa las credenciales del server. Descomentar si hiciera falta.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Modo local (desarrollo) --------------------------------------------------
LOCAL_GOLD_DIR=local_gold

# Puerto asignado al equipo en el Droplet (equipo3 -> 8003)
API_PORT=8003
